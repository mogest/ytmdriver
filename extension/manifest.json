{
  "manifest_version": 3,
  "name": "ytmdriver",
  "version": "0.1.0",
  "description": "Terminal control for YouTube Music",
  "key": "",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://music.youtube.com/*"], "js": ["content.js"] }]
}
